# Amadeus API Credentials
# Get free test credentials at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
AMADEUS_ENV=test  # or "prod" for production

# App Configuration
APP_CACHE_TTL_SECONDS=1800  # 30 minutes

# Optional: TravelBriefing (uses public endpoint by default)
# TRAVELBRIEFING_BASE_URL=https://travelbriefing.org
