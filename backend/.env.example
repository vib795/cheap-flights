# Amadeus API Credentials
# Get free test credentials at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
AMADEUS_ENV=test  # or "prod" for production

# App Configuration
APP_CACHE_TTL_SECONDS=1800  # 30 minutes

# Database Configuration
# For local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./geoflight.db
# For Docker/Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://geoflight:geoflight_dev_password@postgres:5432/geoflight

# Redis Cache (optional, for multi-worker deployments)
# Leave empty to use in-memory cache (single-worker only)
# REDIS_URL=redis://localhost:6379/0
# For Docker:
# REDIS_URL=redis://redis:6379/0

# Optional: TravelBriefing (uses public endpoint by default)
# TRAVELBRIEFING_BASE_URL=https://travelbriefing.org

# Optional: AI-Powered Visa Research (fallback when TravelBriefing fails)
# This uses web search + Claude AI to research visa requirements
# ENABLE_AI_VISA_RESEARCH=true
# ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Get from https://console.anthropic.com/
#
# WARNING: AI-generated visa information is NOT authoritative and must be verified.
# This feature provides helpful context but requires official source verification.
