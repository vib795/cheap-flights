# Docker Environment Configuration
# Copy this to .env and customize with your actual credentials
# IMPORTANT: Never commit .env file to git!

# =====================
# PostgreSQL Database
# =====================
# SECURITY: Change these from defaults in production!
POSTGRES_DB=geoflight
POSTGRES_USER=geoflight
POSTGRES_PASSWORD=change_this_secure_password_in_production

# =====================
# Redis Cache
# =====================
REDIS_URL=redis://redis:6379/0

# =====================
# Amadeus API
# =====================
# Get free test credentials at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
AMADEUS_ENV=test

# =====================
# Optional: AI-Powered Visa Research
# =====================
ENABLE_AI_VISA_RESEARCH=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =====================
# App Configuration
# =====================
APP_CACHE_TTL_SECONDS=1800
